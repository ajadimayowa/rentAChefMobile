{
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "https://rentachefbackend.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "API_BASE_URL": "https://rentachefbackend.onrender.com"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true,
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {}
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}